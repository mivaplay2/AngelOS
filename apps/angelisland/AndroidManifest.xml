<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="os.angel.island" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="29"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <application android:label="Angel Island" android:icon="@mipmap/ic_launcher" android:requestLegacyExternalStorage="true" android:allowBackup="false">
        <service android:name=".IslandService" android:exported="true" android:label="Angel Island" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/island_service"/>
        </service>
        <service android:name=".NotifListener" android:exported="true" android:label="Angel Island" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
        </service>
        <activity android:name=".Wall" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"/>
    </application>
</manifest>
